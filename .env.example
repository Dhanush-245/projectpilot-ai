# Server-only. Bind this from Secret Manager in Cloud Run. Never prefix it VITE_.
GEMINI_API_KEY=

# Verified primary Gemini Developer API model. Optional fallbacks must be
# comma-separated model IDs verified for the same API key/project.
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODELS=

# Must identify the same Firebase project used by the frontend.
FIREBASE_PROJECT_ID=

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL=

# Firebase web configuration. These values are embedded in the browser bundle;
# protect the project with Firebase Security Rules and API-key restrictions.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_DATABASE_ID=
